eover_experiment_enabled\":false,\"cfc_personal_workspace_beacon_experiment_enabled\":true,\"cfc_personal_workspace_homepage_takeover_enabled\":false,\"cfc_personal_workspace_beacon_copy_variant\":\"clinical_answers\"},\"id_type\":\"userID\",\"is_device_based\":false,\"group_name\":\"Clinical answers\",\"is_experiment_active\":true,\"is_user_in_experiment\":true,\"allocated_experiment_name\":\"2752173067\",\"explicit_parameters\":[\"cfc_personal_workspace_beacon_experiment_enabled\",\"cfc_personal_workspace_beacon_enabled\",\"cfc_personal_workspace_beacon_copy_variant\"],\"undelegated_secondary_exposures\":[]},\"2053650222\":{\"name\":\"2053650222\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":2,\"value\":{\"cta_copy_variant\":\"control\"},\"id_type\":\"stableID\",\"is_device_based\":true,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[]},\"2005512729\":{\"name\":\"2005512729\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"value\":{\"create_and_edit_upsell\":false,\"disable\":false,\"enable\":false},\"id_type\":\"userID\",\"is_device_based\":false,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[]},\"3412962132\":{\"name\":\"3412962132\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1654592414\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"427141561\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":3,\"value\":{\"enabled\":true},\"id_type\":\"userID\",\"is_device_based\":false,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[{\"gate\":\"1654592414\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"427141561\",\"gateValue\":\"false\",\"ruleID\":\"default\"}]},\"4245618142\":{\"name\":\"4245618142\",\"rule_id\":\"4A4I0DW9oE8USJxTQegCuj\",\"secondary_exposures\":[{\"gate\":\"3581012973\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"181349320\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":15,\"value\":{\"enabled\":false,\"hide_seat_picker\":false,\"show_seat_guidance\":false},\"id_type\":\"userID\",\"is_device_based\":false,\"group_name\":\"Control\",\"is_experiment_active\":true,\"is_user_in_experiment\":true,\"allocated_experiment_name\":\"2757895784\",\"explicit_parameters\":[\"hide_seat_picker\"],\"undelegated_secondary_exposures\":[{\"gate\":\"3581012973\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"181349320\",\"gateValue\":\"false\",\"ruleID\":\"default\"}]},\"3387299303\":{\"name\":\"3387299303\",\"rule_id\":\"ol49ULEvlqn7TdkKShHRz\",\"secondary_exposures\":[],\"version\":2,\"value\":{\"personal_finance_enabled\":true},\"id_type\":\"userID\",\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":true,\"is_user_in_experiment\":true,\"allocated_experiment_name\":\"2724345805\",\"explicit_parameters\":[\"personal_finance_enabled\"],\"undelegated_secondary_exposures\":[]},\"40865251\":{\"name\":\"40865251\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":12,\"value\":{\"enable_conditional_image_group\":false},\"id_type\":\"userID\",\"is_device_based\":false,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[]},\"1226406985\":{\"name\":\"1226406985\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":16,\"value\":{\"composer-fast-tools\":\"a\",\"centered-composer\":false,\"swipe-sidebar\":false,\"legalese-updates\":true},\"id_type\":\"userID\",\"is_device_based\":false,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[]},\"3732549458\":{\"name\":\"3732549458\",\"rule_id\":\"4wJWW4nALizrdKcR1XijNv\",\"secondary_exposures\":[{\"gate\":\"3879460227\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1237525916\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"790117001\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2067628123\",\"gateValue\":\"false\",\"ruleID\":\"3CuBjEMi97tY3EGnq0NA9s\"},{\"gate\":\"213562696\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1108389362\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2691265090\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"335468445\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3442178281\",\"gateValue\":\"true\",\"ruleID\":\"3lL0brFcX98DIYGN5gIeLL:100.00:1\"}],\"version\":791,\"value\":{\"enable_conversation_audio_summary\":false,\"enable_learning_block_staging_groups\":false,\"enable_multiple_choice_interactivity_v2\":false,\"enable_preview_v2_android\":true,\"enable_fast_model_prefetch\":\"default\",\"enable_learning_quiz_widget\":false,\"enable_latex_content_reference_override\":false,\"is_holdout\":false,\"learning_visualization_use_previous_assistant_message\":false,\"enable_math_block_always_prefetch_v2\":false,\"pass_previous_assistant_message_to_prefetch\":false,\"enable_learning_visualizations\":true,\"enable_visual_concept_widget\":false,\"use_alternate_lb_groups\":\"\",\"graphable_function_v2_shared_intent\":true,\"enable_image_grid_override\":false,\"enable_preview_v2_ios\":true,\"fast_model_prefetch_use_subject_prompt\":false,\"ios_inline_preview_app_block_style_enabled\":false,\"graphable_function_v2_parameterized\":true,\"enable_learning_block_v4\":false,\"enable_math_block_always_prefetch_v4\":false,\"language_learning_block_widget_config\":{\"schema_version\":9,\"pronunciation\":{\"continuation_description\":\"CONTINUATION RULES\\nUse pronunciation after an earlier result only when the newest request explicitly selects exact user-authored text and its reading or locale, and that span still occurs exactly once across all visible user text under newline-equivalent grounding. New bare user text becomes the new source. If a deictic request selects only assistant-rendered text, emit zero cards and answer normally or ask the user to paste it. Ignore unrelated requests and opt-outs.\",\"runtime_descriptions\":{\"pronunciation_audio_text\":\"pronunciation_audio_text: at most 2000 characters.\",\"pronunciation_hint\":\"pronunciation_hint: at most 2000 characters and preserved as one exact string, including embedded line breaks.\",\"follow_up_actions\":\"follow_up_actions: do not emit follow-up actions.\",\"multiple_readings\":\"multiple_readings: build the ordered set of (exact user-authored source_text, explicitly requested reading or locale) pairs. Emit one call per pair in order, including separate calls when one span has multiple requested readings. Never encode alternatives or locale labels inside one hint. A template with unresolved options is not a reading set; emit zero calls and ask the user to choose. If any pair lacks a unique grounded source, unambiguous locale, or one verified reading, emit zero calls.\",\"source_text\":\"source_text: fewer than 2000 raw characters; at 2000 or more, do not call.\",\"contract_heading\":\"PRONUNCIATION RUNTIME CONTRACT\"},\"max_audio_text_characters\":2000,\"overview_description\":\"PRECEDENCE AND SAFETY\\nApply rules in this order: (1) eligibility and resolver safety, (2) intent routing, (3) exact source-and-reading selection, (4) pronunciation fidelity, then (5) outside prose. A direct request must call the matching tool only after every higher-priority prerequisite passes. Otherwise emit no language-learning call and answer normally or ask one concise clarification. Never call translation and pronunciation for the same exact source span, never call merely to expose fallback or alt text, and never claim that a card exists or survived resolution.\",\"source_selection_description\":\"SOURCE SELECTION\\nFor an ordinary pronunciation request, identify the exact complete user-authored source span requested in the newest message; after newline-equivalent uniqueness checks, copy that raw span byte-for-byte. One narrow exception applies to a short direct 'how do you say \u003csource expression\u003e in \u003ctarget language\u003e' request: source_text is the faithful target-language expression that answers the request, not the source-language words inside the command. For example, 'how do you say hello in Chinese' cards the Chinese expression 你好, never the English word hello. This exception is allowed only when the source expression, target language, and one conventional target rendering are unambiguous. Otherwise ask one concise clarification. Never reconstruct inaccessible media or attachment text.\",\"max_source_characters\":2000,\"pronunciation_description\":\"PRONUNCIATION OUTPUT CONTRACT\\nAfter user grounding and locale are unambiguous, an explicit pronunciation request for an ordinary word or phrase should emit a card; do not suppress merely because producing IPA requires phonetic knowledge. Emit exactly one call per explicitly requested source-and-reading pair in order, or zero calls if any pair is unsafe. Each call uses the pair's byte-exact user-authored source_text, supported pronunciation_language, and one reliable canonical pronunciation_hint for that exact reading. Suppress or ask one concise clarification only when the reading genuinely depends on an unknown name, unresolved alternative, variable dialect, ambiguous language or locale, or a specific safety rule such as unmarked East-Slavic lexical stress. Optional pronunciation_audio_text must match the same reading and locale. Never reconstruct assistant or media text, mix intents, encode alternatives in one hint, or rely on fallback or alt text; source-repeating alt text is a mechanism failure, not a pronunciation result.\",\"max_hint_characters\":2000,\"routing_description\":\"ROUTING RULES\\nAfter safety prerequisites pass, use pronunciation when the primary goal is to hear, learn, sound out, romanize, transliterate, or practice an exact word, phrase, sentence, or small explicit set. Also use pronunciation for a short direct say request of the form 'how do you say \u003csource expression\u003e in \u003ctarget language\u003e' (and localized equivalents): first determine the faithful target-language expression, then card that target expression with its canonical pronunciation. A whole-document rewrite, script conversion, replace-all request, spelling check, punctuation edit, or formatting-preservation workflow is a writing transformation and must not emit a pronunciation card. Use translation for other explicit requests to render visible text into a target language. The newest request controls intent, locale, notation, and grouping. Honor opt-outs and never call translation and pronunciation for the same source span.\",\"parameter_descriptions\":{\"pronunciation_language\":\"pronunciation_language: Required BCP-47 playback locale for source_text. For a short direct 'how do you say X in Y' request, use language Y, because source_text is the generated Y-language expression. For ordinary requests, choose the language and locale of the requested utterance, not the instruction language or name origin. If one locale is not unambiguous, emit zero calls and clarify.\",\"contract_heading\":\"PRONUNCIATION PARAMETER CONTRACT\",\"pronunciation_hint\":\"pronunciation_hint: Give one complete canonical pronunciation for exactly source_text in pronunciation_language. For a short direct 'how do you say X in Y' request, the hint must pronounce the generated target-language expression and must never pronounce the source-language phrase. Honor an explicit user-requested notation before every default: if the user asks for IPA, the visible hint must be IPA, not Pinyin, romanization, or respelling. Otherwise emit exactly one learner-facing notation system: use tone-marked Hanyu Pinyin for Mandarin Chinese (for example, 你好 → nǐ hǎo); Jyutping with tone digits for Cantonese (for example, 你好 → nei5 hou2); Hepburn-style romaji with macrons where needed for Japanese (for example, ありがとう → arigatō); and Revised Romanization for Korean (for example, 감사합니다 → gamsahamnida). For every other language, the visible hint MUST be exactly one accurate IPA transcription enclosed in /slashes/; it is never an English-like syllable spelling, mnemonic respelling, or mixed notation. For example, Spanish desayuno may be /de.saˈʝu.no/ with dialect-appropriate IPA, never deh-sah-YOO-no. IPA represents the actual surface pronunciation with obligatory phonology rather than spelling: for an explicit Mandarin IPA request, 你好 uses third-tone sandhi on the first syllable, approximately /ni˧˥ xɑʊ̯˨˩˦/, while ordinary default Pinyin remains nǐ hǎo; standard French inhabituel is /i.na.bi.tɥɛl/, not a nasal initial /ɛ̃.../ and not /...ty.ɛl/. Never default to IPA for the four named learner systems, use Mandarin Pinyin for Cantonese, omit Sinitic tone marks or digits, mix two notation systems in one hint, or use rough-English respelling as the primary hint. Include pronunciation notation only—no meaning, gloss, explanation, alternative, or placeholder.\",\"source_text\":\"source_text: For ordinary pronunciation, use the byte-exact raw user span approved by the grounding gate. For a short direct 'how do you say \u003csource expression\u003e in \u003ctarget language\u003e' request, use the complete faithful target-language expression that answers the request; do not use the source-language phrase or the whole command. Preserve the target expression's natural script, case, punctuation, whitespace, and every token. If the target expression is ambiguous or has no reliable conventional rendering, emit zero calls and clarify.\",\"pronunciation_audio_text\":\"pronunciation_audio_text: Optional hidden playback input for exactly the same canonical reading as source_text and pronunciation_hint. Use ordinary text in pronunciation_language; never put IPA, explanations, stress marks, alternatives, or a foreign-language approximation here. Omit it when native-script source_text is already the best playback input. After a card is selected, if ambiguous or unfamiliar source_text plus locale would speak the wrong hint, use the shortest same-language literal respelling that speaks only the hint; distinct readings need distinct values (e.g. \\\"giff\\\"/\\\"jiff\\\", \\\"taow\\\"). This field cannot change playback speed. For a request to slow audio, never claim the speed changed or distort spelling; omit the card and explain the limitation unless a separate exact user-authored slower practice unit can be carded truthfully.\"},\"outside_prose_description\":\"OUTSIDE PROSE RULES\\nThe card exclusively owns source playback and pronunciation_hint. When a pronunciation card is shown, include one brief useful natural sentence in the user's instruction language, but never repeat the complete source, hint, IPA, transliteration, respelling, or playback text outside the card. Independently requested explanation may discuss a sound, stress, rhythm, or usage without reproducing the full notation. Add no unsupported facts or alternate reading. If no card is called, answer normally without implying that a card was suppressed or created.\"},\"translation\":{\"language_options_by_language\":{\"uk\":[{\"label\":\"Ukrainian\",\"language_code\":\"uk\"}],\"bg\":[{\"language_code\":\"bg\",\"label\":\"Bulgarian\"}],\"mi\":[{\"language_code\":\"mi\",\"label\":\"Maori\"}],\"az\":[{\"label\":\"Azerbaijani\",\"language_code\":\"az\"}],\"vi\":[{\"label\":\"Vietnamese\",\"language_code\":\"vi\"}],\"pt\":[{\"language_code\":\"pt\",\"label\":\"Portuguese\"}],\"bs\":[{\"label\":\"Bosnian\",\"language_code\":\"bs\"}],\"de\":[{\"label\":\"German\",\"language_code\":\"de\"}],\"en\":[{\"language_code\":\"en\",\"label\":\"English\"}],\"ro\":[{\"language_code\":\"ro\",\"label\":\"Romanian\"}],\"fa\":[{\"language_code\":\"fa\",\"label\":\"Persian\"}],\"sr\":[{\"label\":\"Serbian\",\"language_code\":\"sr\"}],\"el\":[{\"label\":\"Greek\",\"language_code\":\"el\"}],\"ar\":[{\"label\":\"Arabic\",\"language_code\":\"ar\"}],\"th\":[{\"label\":\"Thai\",\"language_code\":\"th\"}],\"pl\":[{\"language_code\":\"pl\",\"label\":\"Polish\"}],\"zh-CN\":[{\"language_code\":\"zh-CN\",\"label\":\"Simplified Chinese\"},{\"language_code\":\"zh-TW\",\"label\":\"Traditional Chinese\"}],\"ko\":[{\"label\":\"Korean\",\"language_code\":\"ko\"}],\"tr\":[{\"language_code\":\"tr\",\"label\":\"Turkish\"}],\"id\":[{\"label\":\"Indonesian\",\"language_code\":\"id\"}],\"mr\":[{\"label\":\"Marathi\",\"language_code\":\"mr\"}],\"be\":[{\"language_code\":\"be\",\"label\":\"Belarusian\"}],\"kn\":[{\"label\":\"Kannada\",\"language_code\":\"kn\"}],\"hy\":[{\"language_code\":\"hy\",\"label\":\"Armenian\"}],\"zh-Hans\":[{\"label\":\"Simplified Chinese\",\"language_code\":\"zh-Hans\"},{\"language_code\":\"zh-Hant\",\"label\":\"Traditional Chinese\"}],\"ne\":[{\"label\":\"Nepali\",\"language_code\":\"ne\"}],\"cs\":[{\"label\":\"Czech\",\"language_code\":\"cs\"}],\"es\":[{\"language_code\":\"es\",\"label\":\"Spanish\"}],\"et\":[{\"label\":\"Estonian\",\"language_code\":\"et\"}],\"sw\":[{\"label\":\"Swahili\",\"language_code\":\"sw\"}],\"ta\":[{\"language_code\":\"ta\",\"label\":\"Tamil\"}],\"zh\":[{\"label\":\"Simplified Chinese\",\"language_code\":\"zh\"},{\"label\":\"Traditional Chinese\",\"language_code\":\"zh-TW\"}],\"cy\":[{\"language_code\":\"cy\",\"label\":\"Welsh\"}],\"hu\":[{\"language_code\":\"hu\",\"label\":\"Hungarian\"}],\"zh-Hant\":[{\"language_code\":\"zh-Hans\",\"label\":\"Simplified Chinese\"},{\"language_code\":\"zh-Hant\",\"label\":\"Traditional Chinese\"}],\"fr\":[{\"language_code\":\"fr\",\"label\":\"French\"}],\"zh-MO\":[{\"language_code\":\"zh-CN\",\"label\":\"Simplified Chinese\"},{\"label\":\"Traditional Chinese\",\"language_code\":\"zh-MO\"}],\"ru\":[{\"label\":\"Russian\",\"language_code\":\"ru\"}],\"sv\":[{\"language_code\":\"sv\",\"label\":\"Swedish\"}],\"fi\":[{\"language_code\":\"fi\",\"label\":\"Finnish\"}],\"zh-TW\":[{\"label\":\"Simplified Chinese\",\"language_code\":\"zh-CN\"},{\"language_code\":\"zh-TW\",\"label\":\"Traditional Chinese\"}],\"sk\":[{\"label\":\"Slovak\",\"language_code\":\"sk\"}],\"kk\":[{\"label\":\"Kazakh\",\"language_code\":\"kk\"}],\"da\":[{\"language_code\":\"da\",\"label\":\"Danish\"}],\"gl\":[{\"label\":\"Galician\",\"language_code\":\"gl\"}],\"zh-HK\":[{\"language_code\":\"zh-CN\",\"label\":\"Simplified Chinese\"},{\"label\":\"Traditional Chinese\",\"language_code\":\"zh-HK\"}],\"ja\":[{\"language_code\":\"ja\",\"label\":\"Japanese\"}],\"ur\":[{\"label\":\"Urdu\",\"language_code\":\"ur\"}],\"is\":[{\"label\":\"Icelandic\",\"language_code\":\"is\"}],\"sl\":[{\"language_code\":\"sl\",\"label\":\"Slovenian\"}],\"hr\":[{\"label\":\"Croatian\",\"language_code\":\"hr\"}],\"ca\":[{\"label\":\"Catalan\",\"language_code\":\"ca\"}],\"zh-SG\":[{\"label\":\"Simplified Chinese\",\"language_code\":\"zh-SG\"},{\"label\":\"Traditional Chinese\",\"language_code\":\"zh-TW\"}],\"lt\":[{\"label\":\"Lithuanian\",\"language_code\":\"lt\"}],\"nl\":[{\"label\":\"Dutch\",\"language_code\":\"nl\"}],\"no\":[{\"language_code\":\"no\",\"label\":\"Norwegian\"}],\"lv\":[{\"label\":\"Latvian\",\"language_code\":\"lv\"}],\"hi\":[{\"language_code\":\"hi\",\"label\":\"Hindi\"}],\"he\":[{\"label\":\"Hebrew\",\"language_code\":\"he\"}],\"mk\":[{\"language_code\":\"mk\",\"label\":\"Macedonian\"}],\"tl\":[{\"label\":\"Tagalog\",\"language_code\":\"tl\"}],\"ms\":[{\"label\":\"Malay\",\"language_code\":\"ms\"}],\"it\":[{\"language_code\":\"it\",\"label\":\"Italian\"}],\"af\":[{\"language_code\":\"af\",\"label\":\"Afrikaans\"}]},\"overview_description\":\"AUTHORITATIVE TRANSLATION PROCEDURE\\nUse this single ordered procedure; no later field may add another source search or eligibility exception. (0) Emit no translation call for named-language content creation or for identifying, comparing, or explaining named-language terms or usage unless the user also explicitly requests source-to-target translation, which then follows existing routing. (1) Apply the HARD CODE GATE: if the requested artifact contains executable or machine-readable SQL, source code, JSON, XML, HTML tags, configuration, shell commands, or similar syntax-sensitive literals, emit no language-learning call even when prose surrounds the syntax or the user asks to translate while preserving it; use the ordinary code/writing surface. Human-readable prose is still eligible when it merely contains technical terms, names, numbers, links, or Markdown presentation. (2) Classify the newest turn as new source payload, command-only continuation, retry, or explicit reference. Translation commands, language labels, deictic words, and workflow instructions are never source. (3) Lock one complete artifact with SOURCE SELECTION. (4) Apply only explicit visible edits. (5) Lock the target. (6) Translate every unit and emit the complete result. If source or target remains genuinely ambiguous, ask one concise clarification. Never emit translation and pronunciation for the same source span.\",\"outside_prose_description\":\"OUTSIDE PROSE\\nThe translation card exclusively owns the standalone source-to-translation answer. Preserve useful request-proportional information that a high-quality answer without the widget would provide, such as register, nuance, literal composition, word or character breakdowns, grammar, regional usage, common alternatives, or grounded examples. Never add an introductory or concluding sentence whose only purpose is to restate '\u003csource\u003e in \u003ctarget language\u003e is \u003ctranslated_text\u003e', and never quote or reproduce the complete translated_text as a second standalone answer outside the card. It is valid to reference individual translated words or characters when they are necessary for a genuine explanation, and valid to use the expression naturally inside a grounded example. If no useful nonredundant information exists, emit no outside prose. If no card is emitted, answer normally with the full appropriate information.\",\"source_selection_description\":\"SOURCE SELECTION\\nFirst classify the newest user turn without consulting history. If it is a new payload in an established translation workflow, lock the whole newest message as source even when it is short or contains ordinary pronouns such as this, that, it, or them; only a pronoun attached to a translation command acts as a reference. Otherwise apply COMMAND-ONLY CONTINUATIONS AND RETRIES. A bare translation command after a substantive assistant explanation selects that entire explanation. A repeated command after a command echo selects the unresolved pre-command artifact. An explicit earlier/original reference across a meta detour selects the unresolved artifact that preceded the detour. An all/them reference to offered options selects every distinct option; a later recommendation does not narrow the set. User and assistant artifacts are both eligible. Historical widget payloads and older translation pairs never override the selected newer artifact. Once selected, lock from the first substantive character of the artifact through the last: include opening qualifiers, all paragraphs, headings, list items, examples, numbers, closings, and emojis. Never select the command, its literal translation, an acknowledgment, an analysis detour, a stale example, or a narrower excerpt. For edit-then-translate, apply only explicit edits after the boundary lock. At 5000 or more raw characters, ambiguity, or a HARD CODE GATE match, emit no card.\",\"max_source_characters\":5000,\"max_follow_up_actions\":3,\"runtime_descriptions\":{\"follow_up_actions\":\"follow_up_actions: optional; emit zero to three valid, distinct, self-contained, source-grounded actions for a translation card; render at most max_follow_up_actions=3. Never pad the bar with a generic or low-value action.\",\"contract_heading\":\"TRANSLATION RUNTIME CONTRACT\",\"source_text\":\"source_text: fewer than 5000 raw characters; at 5000 or more, do not call.\",\"translated_text\":\"translated_text: at most 100000 characters and complete for the selected source.\"},\"translation_description\":\"COMPLETE TRANSLATION\\nTranslate every meaning-bearing unit of the locked post-edit source exactly once and in order. Preserve the first source unit and opening qualifier, then every paragraph, actor, action, object, relation, negation, modality, aspect, scope, quantity, date, name, identifier, contrast, repetition, list item, example, heading, and closing through the final source unit. Apply the newest visible correction or requested edit, but retain all untouched material. Do not add a greeting, answer, explanation, inferred context, invented tone, or unrelated content. Audit first-to-first, last-to-last, and every intervening unit before emission. An ordinary request emits one complete translation card. A referenced list or option set is one complete source: include every distinct offered item in one card in the same order, even when one item was later recommended or repeated. Emit two or three complete cards only when the visible user request explicitly asks for alternative renderings or when the same source has materially different plausible tones and visible context cannot choose.\",\"parameter_descriptions\":{\"follow_up_action_query\":\"follow_up_action_query: A fully self-contained command in the user's instruction language that can produce the promised useful result without hidden conversation context. Include the complete relevant source or exact translated expression, the target language, and the selected operation. For a retranslation, request the complete revised target-language rendering while preserving the same source meaning and scope. For pronunciation practice, identify the exact short translated expression or exact selected key terms and language; do not request vague or low-value pronunciation of an entire long document. Never rely on the label alone, invent context, change target language, narrow the source, or ask only for commentary, a diff, or an explanation when the label promises a revised translation.\",\"follow_up_actions\":\"follow_up_actions: Optional for every emitted translation card. When no genuinely useful next step exists, emit none instead of padding. Otherwise emit one to three useful, distinct, self-contained actions in the user's instruction language; prefer three only when all three add real value. Keep the same complete source and target. Choose actions from the actual source type, length, and visible user goal: for a short phrase, useful options can be a natural/formal/literal/regional retranslation or pronunciation practice for the exact translated expression; for work, email, report, or document text, useful options can be a tighter complete rendering, a more natural or audience-appropriate register already supported by context, or terminology/format-preserving refinement; for long text, do not offer low-value full-document pronunciation, and offer pronunciation only for exact selected key terms when that would genuinely help. Every visible label must advertise a concrete benefit before clicking, and every query must request a complete useful result. Never invent an audience or scenario, change source scope or target, duplicate the translation outside the card, or pad with generic, overlapping, unsupported, or low-value actions.\",\"contract_heading\":\"TRANSLATION PARAMETER CONTRACT\",\"follow_up_action_weight\":\"follow_up_action_weight: Relative ranking score used when callers select which actions to show.\",\"follow_up_action_icon\":\"follow_up_action_icon: Optional leading icon name rendered inside the action button.\",\"source_text\":\"source_text: The complete locked source selected by the continuation rules and worked decisions. A new short phrase in an established workflow is the whole newest source. A bare Translate after a substantive assistant message selects that whole message. A repeated command after a command echo retries the pre-command artifact. An earlier/original reference across a meta detour selects the unresolved pre-detour source. An all/them reference includes every distinct offered option. Copy from the first substantive character through the last, including opening qualifiers, every paragraph and every list item. Never use an older widget payload, command, command echo, analysis detour, stale source, or partial artifact. Count the complete locked source before calling: it must be fewer than 5000 raw characters and not blocked by HARD CODE GATE; at 5000 or more, emit zero calls and never truncate to fit.\",\"follow_up_action_label\":\"follow_up_action_label: A concise benefit-first label in the user's instruction language. The user should be able to predict the useful result before clicking. Make it specific to the visible goal and source, such as 'Make it a tighter status bullet', 'Use more natural business Japanese', 'Compare literal wording', or 'Practice the key Japanese terms'. Do not use bare generic labels such as 'Alternative', 'More concise', 'Example', 'Status-report example', or 'Pronunciation'.\",\"translated_text\":\"translated_text: One complete target-language rendering of source_text from its first unit through its last. Preserve the opening qualifier, all paragraphs, lines, headings, options, examples, numbers, and closings. For a referenced list, include every distinct offered item in the same card and order. Add no unsupported facts and omit nothing.\",\"target_language\":\"target_language: Use the destination explicitly named by the newest request. Otherwise preserve the single active destination of the unresolved retry or established translation workflow for the selected source. A command-only request following a visible artifact may use the one unambiguous destination established by that conversation. Never translate a target-language label as source and never infer from command language alone. If multiple destinations remain plausible, clarify.\"},\"continuation_description\":\"COMMAND-ONLY CONTINUATIONS AND RETRIES\\nAfter removing the operative translation command, target label, reference words, and workflow metadata from the newest turn: if substantive payload remains, stop and use it. Otherwise resolve in this order. (1) An explicit reference such as the earlier/original/above sentence, the list, all, or them selects that complete referenced artifact even when it is not adjacent; reference meaning outranks recency. (2) If the command repeats an immediately preceding translation request that was not fulfilled, skip the intervening command echo, literal command translation, refusal, or discussion and retry the same unresolved complete source and target. (3) Otherwise a bare translate/translate this/in \u003clanguage\u003e selects the complete immediately preceding substantive assistant artifact when it was not merely a response to that same translation command. (4) A plural reference selects the complete finite set, not a subset. A meta detour to analyze, acknowledge, or record workflow rules is context, not source, when the latest request then asks to translate the earlier/original text. Stop at the first unambiguous match.\\nWORKED DECISIONS\\n- Established translation workflow; user supplies a new short phrase without a command: translate that new phrase, never the prior phrase.\\n- Assistant gives a substantive explanation or draft; user says only Translate: translate the entire explanation or draft, not an older user sentence or older widget payload.\\n- User says translate into a language; assistant only echoes/translates that command; user repeats it: retry the substantive artifact from before the first command.\\n- Assistant offers several reply options; user says translate them/all: translate every distinct offered option in one complete ordered card.\\n- A translation task detours through analysis of a mistake; user says remember that and translate the earlier/original sentence: translate the unresolved pre-detour source, not the analysis request or analysis answer.\\\\n- In an established translation workflow, first classify the newest source-language turn by function. A bare content-like deictic utterance such as German 'Das meine ich' ('that is what I mean'), English 'that's what I mean', or Spanish 'eso quiero decir' is the newest source payload; translate that utterance and never reuse the prior source. But complaint or feedback about the assistant or prior answer is never source, even when written in the active source language or when it repeats words such as 'translate' or 'translation'; for example, a turn meaning 'why can you not follow my instructions; all I asked was translate' must not be translated or shown in a language-learning widget. Complaint/feedback precedence wins over this deictic-payload rule. Workflow instructions and opt-outs also remain non-source.\",\"max_output_characters\":100000,\"routing_description\":\"TRANSLATION ROUTING\\nUse translation for an explicit cross-language request or an established translation workflow. In an established workflow, any new bare word, phrase, sentence, or document in the newest user turn is the new source even without a translation verb; it must never lose to older history. A command-only request may select a clearly referenced visible user or assistant artifact. Treat every language's semantic equivalent of translate, translation, render, in/to/into \u003clanguage\u003e, translate this/it/them/all, and Dịch as an operative command, not translatable payload. A repeated command after an answer that merely echoed, translated, or discussed the command is a retry of the unresolved earlier source, not a request to translate that answer. Do not call for pronunciation, romanization, transliteration, reading aloud, an opt-out, inaccessible media, or anything blocked by the HARD CODE GATE.\"},\"version\":\"trigger_v342\",\"enabled\":true},\"enable_math_block_always_prefetch_v3\":false,\"enabled_learning_blocks_lightweight_web\":false,\"enable_graphable_function_v2\":true,\"enable_learning_block_v3\":false,\"enable_explicit_type_id\":false,\"enable_pronunciation_block_v4_audio_fix_v2\":false,\"enable_lb_previous_assistant_keyword_trigger\":false,\"enable_lb_group_keyword_trigger_500\":false,\"enable_preview_with_thumbnail\":true,\"learning_visualization_prompt_key\":\"\",\"enable_lb_physics_motion_forces_always_prefetch\":false,\"enable_graphable_function_v2_renderer\":true,\"enable_math_block_always_prefetch_variant\":false,\"enable_pronunciation_block_v4_audio_fix_v2_realtime_audio_mini\":false,\"fast_model_prefetch_use_sheep_backend\":true,\"enable_genui_with_common_keywords\":false,\"enable_learning_block_v4_groups\":false,\"learning_blocks_inclusion_for_fast_model\":false,\"enable_learning_blocks_group_keywords\":true,\"enable_learning_block_graphable_split_groups\":false,\"learning_block_prompt_key\":\"\",\"enable_learning_block_groups_with_graphable_regex\":false,\"enable_learning_block_parameterized_groups\":false,\"visual_concept_widget_config\":{},\"enable_lb_block_keyword_trigger_1000\":false,\"enable_learning_block_trigger_keywords_v2\":false,\"enable_lb_biology_health_immunity_microbiology_always_prefetch\":false,\"enable_genui\":false,\"fast_model_prefetch_guaranteed_prefetch_budget_seconds\":0.35,\"share_button_enabled\":false,\"enable_multiple_choice_interactivity\":false,\"enable_learning_block_groups\":false,\"enable_lb_group_keyword_trigger_1000\":false,\"enable_lb_chemistry_atoms_molecules_matter_always_prefetch\":false},\"id_type\":\"userID\",\"is_device_based\":false,\"group_name\":\"release_cadidate_test\",\"is_experiment_active\":true,\"is_user_in_experiment\":true,\"allocated_experiment_name\":\"94228759\",\"explicit_parameters\":[\"language_learning_block_widget_config\",\"enable_pronunciation_block_v4_audio_fix_v2\"],\"undelegated_secondary_exposures\":[{\"gate\":\"3879460227\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1237525916\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"790117001\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2067628123\",\"gateValue\":\"false\",\"ruleID\":\"3CuBjEMi97tY3EGnq0NA9s\"},{\"gate\":\"213562696\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1108389362\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2691265090\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"335468445\",\"gateValue\":\"false\",\"ruleID\":\"default\"}]},\"1001885924\":{\"name\":\"1001885924\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"2546976668\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2397856673\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":28,\"value\":{\"require_immediate_cancellation\":false},\"id_type\":\"workspace_id\",\"is_device_based\":false,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[{\"gate\":\"2546976668\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2397856673\",\"gateValue\":\"false\",\"ruleID\":\"default\"}]},\"3069125177\":{\"name\":\"3069125177\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":10,\"value\":{\"should_deep_link_homepage_to_native_app\":false,\"custom_banner_variant\":\"control\",\"should_suppress_browser_native_banners\":false},\"id_type\":\"userID\",\"is_device_based\":false,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[]},\"585757063\":{\"name\":\"585757063\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"173455834\",\"gateValue\":\"false\",\"ruleID\":\"2KWSufVL8dOFzVbECQKODl:2.00:3\"}],\"version\":6,\"value\":{\"share_modal_streaming_clipboard_copy_enabled\":true},\"id_type\":\"userID\",\"is_device_based\":false,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[{\"gate\":\"173455834\",\"gateValue\":\"false\",\"ruleID\":\"2KWSufVL8dOFzVbECQKODl:2.00:3\"}]},\"3880965684\":{\"name\":\"3880965684\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":57,\"value\":{\"show_memory_off_beacon_banner\":true,\"show_recent_convos_off_beacon_banner\":true,\"should_autoscroll_memory_off_tooltip\":false,\"show_memory_off_beacon_banner_experiment_enabled\":true,\"