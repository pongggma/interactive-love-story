00,\"o3_pro\":1200,\"o1_pro\":1200},\"model_slug_intervals\":{\"image_gen\":10,\"gpt_4o\":2},\"polling_fallback_on_message_insertion_error\":[{\"fallback_mode\":\"final_assistant_answer\"}]},\"is_device_based\":false,\"passed\":true},\"3923090434\":{\"name\":\"3923090434\",\"rule_id\":\"3oWlxtnoHKmdKG6BLo9K8B:100.00:5-3oWlxrImfscJrgyGage6Pz\",\"secondary_exposures\":[],\"version\":30,\"id_type\":\"userID\",\"value\":{\"2026-06-22\":[\"Scan editors: You can now add scan editors to your configured repositories. Scan editors can update scans, including editing threat models, configuring notification rules, and managing scan sharing.\"],\"changelog_latest_date\":\"2026-06-22\",\"2026-05-04\":[\"Slack notifications: Get notified about new findings with the Codex Slack app. Go to the Scans page and select a scan you own to set up and customize alerts by severity, path, and keywords.\"]},\"is_device_based\":false,\"passed\":true},\"1616547632\":{\"name\":\"1616547632\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{\"hidden_connector_ids\":[\"connector_openai_olympic\"]},\"is_device_based\":false,\"passed\":false},\"217573384\":{\"name\":\"217573384\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":21,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"2712016364\":{\"name\":\"2712016364\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":6,\"id_type\":\"userID\",\"value\":{\"staleTimeMs\":300001,\"gcTimeMs\":1800001},\"is_device_based\":false,\"passed\":false},\"1504865540\":{\"name\":\"1504865540\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":9,\"id_type\":\"userID\",\"value\":{\"max_file_size_mb\":25},\"is_device_based\":false,\"passed\":false},\"208167308\":{\"name\":\"208167308\",\"rule_id\":\"7uYELGfSxFkdaBTPBgh12s:100.00:29-7uYELEAQ5naIRclU08lnJq\",\"secondary_exposures\":[{\"gate\":\"2054053781\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3737660407\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3922602262\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1326334369\",\"gateValue\":\"true\",\"ruleID\":\"1whsR1iZoYMplZvM8wDcvp:100.00:7\"},{\"gate\":\"957497898\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":399,\"id_type\":\"userID\",\"value\":{\"max_turns_per_conversation\":175,\"active_task_limit_message_template\":\"You've reached your limit of {active_limit} active tasks. To schedule more tasks, consider pausing some tasks.\",\"gaas_extra_features\":{\"multi_agent\":true,\"fast_mode\":true},\"slack_webhook_bot_membership_message_template\":\"I couldn't create an immediate Slack monitor because @ChatGPT isn't in {channel}. I can still set up an hourly monitor right now, or you can install or reconnect the [ChatGPT Slack app](https://chatgpt.com/slack-ai-app-install), add @ChatGPT to the channel, and try again for immediate notifications. Which would you like?\",\"exact_schedule_jitter_radius_seconds\":240,\"bypass_chat_model_output\":true,\"automations_create_plan_tool_additional_guidance\":\"The user has created an automation for an ongoing goal with a private plan. Collaborate with the user across turns, use available structured context to understand their goals and prior progress, and help advance the saved plan.\",\"exact_schedule_proactive_start_offset_seconds\":10,\"enable_file_export\":true,\"fiber_tool_call_elicitation_mode\":\"elicit_on_writes\",\"fiber_generic_chatgpt_builtin_tool_references\":[{\"tool_type\":\"ToolRef\",\"tool_id\":\"automations\"},{\"tool_type\":\"ToolRef\",\"tool_id\":\"image_gen\"}],\"max_active_automations\":3,\"condition_watch_jitter_radius_seconds\":360,\"break_plugin_service_brte_history_chain\":true,\"enable_browser_tool\":true,\"tool_model_instructions\":\"\",\"automations_create_tool_additional_guidance\":\"Do NOT mention the automation id to the user in  your response.\",\"fiber_use_generic_chatgpt_builtin_tools\":true,\"validate_automation_prompt_template\":\"\",\"enable_whisper\":false,\"general_agent_invoked_system_hints\":[],\"automations_list_tool_additional_guidance\":\"The UI will already render the user's active automations from this list result. The automations will be rendered below your response Do NOT restate active automations in prose unless adding information not already visible to the user. Do not tell the user about any automations with enabled = false. They are considered deleted. You do not need to mention the UI either. Simply summarize in 1 sentence or less what automations exist.\\n\\nDo not call the automations `list` action again this turn; use the automations `peek` action for any further inspection.\",\"max_messages_per_conversation\":1000,\"personalized_task_card_read_timeout_seconds\":0.225,\"private_peek_enabled\":true,\"fiber_sync_suggestable_connectors_to_workspace\":false,\"additional_developer_message_prompt\":\"If you do not have an update for the user during this automation turn, you must emit `::SKIP_COMPLETION::`. UNLESS you have clarifying questions for the user that will help you perform your task - in which case, feel free to ask that question. \\n\\nExamples for when to output `::SKIP_COMPLETION::`:\\n- If the user asks you to let them know when a reservation opens up at Cotogna at a specific time, and you find out that there is still no reservation available\\n- If the user asks you to let them know when they have a new email but there are no new emails since your last run\",\"fiber_sync_hazelnut_skills_to_workspace\":false,\"webhook_trigger_user_prompt_template\":\"{automation_prompt}\\n\\nThis run was triggered by a webhook event. Use the event below as the new information to evaluate for this run.\\nWebhook family: {family}\\nWebhook event:\\n{normalized_event_json}\",\"model_lane_override\":\"auto\",\"override_default_tools\":false,\"fiber_gaas_model\":\"gpt-5.4-2s-codex-